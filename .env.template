# Institutional Deployment Secrets Template
# WARNING: NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL

# Execution Environment
PYTHONENV=production
DEPLOYMENT_MODE=PAPER_TRADING_ONLY

# Data Providers
MARKET_DATA_API_KEY=your_api_key_here
FINANCIAL_NEWS_API_KEY=your_news_key_here

# Governance Overrides
# Only set to TRUE if explicitly manually authorized by governance board
MANUAL_PROMOTION_OVERRIDE=FALSE

# Observability
TELEMETRY_ENDPOINT=http://localhost:9090
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
